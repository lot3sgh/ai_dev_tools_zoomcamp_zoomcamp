POSTGRES_DB=health_pipeline
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me
PGHOST=localhost
PGPORT=5433
# Path to the Google service account key for Drive mode (optional for local mode)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# Read-only analytics login (Grafana dashboard); provisioned idempotently
# DASHBOARD_DB_PASSWORD=change_me_dashboard
# Read-only chatbot login (Health Assistant Semantic Layer); provisioned idempotently
# CHATBOT_DB_PASSWORD=change_me_chatbot
#
# Health Assistant LLM provider (Phase 3): an OpenAI-compatible seam selected by env.
#   LLM_PROVIDER=stub      -> deterministic demo provider (corpus questions compute real
#                             SQL against the DB; no key, no network — dev/demo only)
#   (anything else/empty)  -> the OpenAI-compatible adapter configured below
#
# PRIVACY: with a hosted gateway (the default), your questions AND the result rows they
# produce transit the provider's infrastructure — the Chat Log records which provider
# answered, and there is NO silent local fallback when the provider is down or missing.
#
# OpenCode Go gateway (subscription): base URL and model id are verified against the
# gateway's model list (curl https://opencode.ai/zen/go/v1/models) — never guess either.
# The chained "opencode-go/<model>" form is OpenCode's own config key, not the API id.
# LLM_PROVIDER=opencode-go
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=change_me
# Ollama local (privacy default) is one config flip: LLM_BASE_URL=http://localhost:11434/v1,
# LLM_MODEL=<your model>, drop the key.
#
# Grafana's own login (defaults: admin / change_me_grafana)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change_me_grafana